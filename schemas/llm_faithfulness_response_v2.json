{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faithrec-mm/llm-faithfulness-response/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explanation",
    "primary_evidence",
    "claimed_image_share",
    "claimed_text_share",
    "confidence",
    "conflict_detected",
    "abstained"
  ],
  "properties": {
    "explanation": {"type": "string", "minLength": 1, "maxLength": 1200},
    "primary_evidence": {
      "type": "string",
      "enum": ["image", "text", "insufficient"]
    },
    "claimed_image_share": {"type": "number", "minimum": 0, "maximum": 1},
    "claimed_text_share": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "conflict_detected": {"type": "boolean"},
    "abstained": {"type": "boolean"}
  }
}
